[Unit]
Description=FlashShare daily backup (PostgreSQL + Gokapi)
Documentation=file:/opt/flashshare/scripts/backup.sh
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/flashshare/scripts/backup.sh
# failure logging: journal captures stderr; non-zero exit marks unit failed
Environment=FLASHSHARE_BACKUP_REMOTE=
