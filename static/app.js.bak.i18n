};
function fmtIcon(name) {
  const ext = (name||"").toLowerCase().match(/\.(\w+)$/);
  if (!ext) return "";
  const type = EXT_TO_TYPE[ext[1]];
  if (!type) return "";
  return '<span class="fmt-badge fmt-'+type+'" aria-hidden="true"><svg viewBox="0 0 24 24">'+FORMAT_SVG[type]+'</svg></span>';
}

