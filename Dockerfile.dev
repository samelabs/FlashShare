# 本地开发镜像 — 依赖版本镜像生产（Ubuntu 24.04 apt，见 requirements.txt 注释）
# 生产环境不使用本文件（生产为系统 python + systemd，见 run.sh）
FROM python:3.12-slim

WORKDIR /opt/flashshare

COPY requirements.txt .
# apt 的 fastapi 0.101.0 + starlette 0.31.1 组合违反上游 pin，必须 --no-deps 先装
RUN pip install --no-cache-dir --no-deps fastapi==0.101.0 starlette==0.31.1 \
    && pip install --no-cache-dir -r requirements.txt

EXPOSE 8000
CMD ["python", "-m", "uvicorn", "app.main:app", \
     "--host", "0.0.0.0", "--port", "8000", \
     "--reload", "--proxy-headers", "--forwarded-allow-ips=*"]
