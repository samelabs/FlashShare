def render_file_landing(upload, live, user=None, lang="en") -> str:
    texts = server_text(lang)
    locale = LOCALE_TAGS.get(lang, "en")
    direction = "rtl" if lang == "ar" else "ltr"
    expire_at = (live or {}).get("ExpireAt") or upload["expire_at"]
    total = upload["allowed_downloads"]
    remaining = (live or {}).get("DownloadsRemaining")
    count = (live or {}).get("DownloadCount")
    if isinstance(count, int):
        downloads = f"{count}/{total}"
    elif isinstance(remaining, int):
        downloads = f"{max(0, total - remaining)}/{total}"
    else:
        downloads = f"0/{total}"
    file_name = html_escape(upload["file_name"])
    file_label_text = f"{upload['file_name']} · {format_bytes(upload['size_bytes'])}"
    compact_title_text = f"{compact_filename(upload['file_name'])}({format_bytes(upload['size_bytes']).replace(' ', '')})-{format_share_date(expire_at)}（{downloads}）"
    card_desc_text = f'{texts["card_expires"]}: {format_ts(expire_at)} · {texts["card_downloads"]}: {downloads}'
    file_label = html_escape(file_label_text)
    card_desc = html_escape(card_desc_text)
    card_title = html_escape(compact_title_text)
    public_id = urllib.parse.quote(upload["public_id"])
    url = public_file_url(upload["public_id"])
    escaped_url = html_escape(url)
    share_url = html_escape("https://x.com/intent/tweet?" + urllib.parse.urlencode({"text": texts["share_text"], "url": url}))
    return f"""<!doctype html>
<html lang="{locale}" dir="{direction}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{card_title}</title>
  <meta name="description" content="{card_desc}">
  <meta name="theme-color" content="#0f1419">
  <link rel="canonical" href="{escaped_url}">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{card_title}">
  <meta property="og:description" content="{card_desc}">
  <meta property="og:url" content="{escaped_url}">
  <meta property="og:image" content="{SOCIAL_IMAGE_URL}">
  <meta property="og:image:secure_url" content="{SOCIAL_IMAGE_URL}">
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{file_label}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{card_title}">
  <meta name="twitter:description" content="{card_desc}">
  <meta name="twitter:image" content="{SOCIAL_IMAGE_URL}">
  <meta name="twitter:image:alt" content="{file_label}">
  <style>{CSS}</style>
</head>
<body>
  <main class="shell file-shell">
    {shared_header(user, lang, texts, share_url=share_url)}
    <section class="file-page">
      <div class="file-card">
        <div class="file-card-head">
          {file_format_icon(upload["file_name"])}
          <div class="file-card-info">
            <h1 id="fileName">{file_name}</h1>
            <dl class="file-facts">
              <div>{file_size_icon_svg()}<dd>{format_bytes(upload["size_bytes"])}</dd></div>
              <div>{expiry_icon_svg()}<dd>{format_ts(expire_at)}</dd></div>
              <div>{download_count_icon_svg()}<dd>{downloads}</dd></div>
            </dl>
          </div>
        </div>
        <div class="workspace-tools" id="workspaceTools" data-pid="{public_id}">{'<div class="tools-bar" id="ownerTools"><button class="tool-btn" id="renameBtn"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg><span>' + html_escape(texts.get("rename", "Rename")) + '</span></button><button class="tool-btn danger" id="deleteBtn"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg><span>' + html_escape(texts.get("delete", "Delete")) + '</span></button></div>' if user and "user_id" in upload.keys() and user["id"] == upload["user_id"] else ''}</div>
      </div>
      <div class="file-actions">
        <a class="action-btn primary" href="/f/{public_id}?download=1" aria-label="Download"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11"></path><path d="M7 10l5 5 5-5"></path><path d="M5 20h14"></path></svg><span>{html_escape(texts["download_file"])}</span></a>
