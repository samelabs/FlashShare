    </div>
  </div>
  <div class="modal hidden" id="toolModal" role="dialog" aria-modal="true">
    <div class="modal-panel">
      <button class="modal-close" id="toolModalClose" type="button" aria-label="Close">{close_icon_svg()}</button>
