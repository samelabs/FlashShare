      convert: '<path d="M16 3l4 4-4 4"></path><path d="M20 7H4"></path><path d="M8 21l-4-4 4-4"></path><path d="M4 17h16"></path>',
      info: '<circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path>',
      hash: '<path d="M4 9h16"></path><path d="M4 15h16"></path><path d="M10 3L8 21"></path><path d="M16 3l-2 18"></path>',
      trash: '<path d="M3 6h18"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>',
    }};

    // Tool modal system
    const toolModal = document.getElementById("toolModal");
    const toolModalBody = document.getElementById("toolModalBody");
    function openToolModal(html) {{ toolModalBody.innerHTML = html; toolModal.classList.remove("hidden"); }}
    function closeToolModal() {{ toolModal.classList.add("hidden"); toolModalBody.innerHTML = ""; }}
    document.getElementById("toolModalClose").addEventListener("click", closeToolModal);
    toolModal.addEventListener("click", (e) => {{ if (e.target === toolModal) closeToolModal(); }});

    function toolLoading() {{ return '<div class="tool-loading">{html_escape(texts.get("loading", "Loading..."))}</div>'; }}
    function toolError(msg) {{ return '<p class="tool-error">' + (msg || "error") + '</p>'; }}

    // Bind owner buttons (server-rendered, no flash)
    const renameBtn = document.getElementById("renameBtn");
    if (renameBtn) renameBtn.addEventListener("click", () => openRename(pid));
    const deleteBtn = document.getElementById("deleteBtn");
    if (deleteBtn) deleteBtn.addEventListener("click", () => openDelete(pid));

    // Load file-type tools (async, append after owner buttons)
    (async () => {{
      if (!wsContainer) return;
      try {{
        const r = await fetch("/drop-api/tools/" + pid);
        const data = await r.json();
        if (!data.ok || !data.tools || data.tools.length === 0) return;
        let bar = document.getElementById("ownerTools");
        if (!bar) {{ bar = document.createElement("div"); bar.className = "tools-bar"; wsContainer.appendChild(bar); }}
        data.tools.forEach(t => {{
          const locked = t.type === "produce" && !data.is_owner;
          bar.appendChild(makeToolBtn(t.icon, t.label["{lang}"] || t.label["en"], () => execTool(pid, t), false, locked));
        }});
      }} catch(e) {{}}
    }})();

    function makeToolBtn(icon, label, onClick, danger, locked) {{
      const btn = document.createElement("button");
      btn.className = "tool-btn" + (danger ? " danger" : "") + (locked ? " locked" : "");
      btn.innerHTML = '<svg viewBox="0 0 24 24" aria-hidden="true">' + (TOOL_ICONS[icon] || TOOL_ICONS.info) + '</svg><span>' + label + "</span>";
      btn.addEventListener("click", onClick);
      return btn;
    }}

    function openRename(pid) {{
      const h1 = document.getElementById("fileName");
      const oldName = h1.textContent.trim();
      const dotIdx = oldName.lastIndexOf(".");
      const stem = dotIdx > 0 ? oldName.substring(0, dotIdx) : oldName;
      openToolModal('<div class="tool-panel"><h3>{html_escape(texts.get("rename", "Rename"))}</h3><input type="text" id="renameInput" value="' + stem.replace(/"/g, '&quot;') + '" maxlength="200"><div class="tool-panel-actions"><button class="action-btn primary" id="renameConfirm">✓</button></div></div>');
      const input = document.getElementById("renameInput");
      input.focus(); input.select();
      document.getElementById("renameConfirm").addEventListener("click", async () => {{
        const v = input.value.trim();
        if (!v || v === stem) {{ closeToolModal(); return; }}
        openToolModal(toolLoading());
        try {{
          const r = await fetch("/drop-api/rename", {{ method:"POST", headers:{{"Content-Type":"application/json"}}, body: JSON.stringify({{public_id:pid, name:v}}) }});
          const data = await r.json();
          if (data.ok) {{ h1.textContent = data.name; document.title = data.name; closeToolModal(); }}
          else openToolModal(toolError(data.error));
        }} catch(e) {{ openToolModal(toolError(e.message)); }}
      }});
    }}

    function openDelete(pid) {{
      openToolModal('<div class="tool-panel"><h3>{html_escape(texts.get("delete", "Delete"))}</h3><p class="tool-confirm-text">{html_escape(texts.get("confirmDelete", "Delete this file?"))}</p><div class="tool-panel-actions"><button class="action-btn" id="delCancel">✕</button><button class="action-btn primary" id="delConfirm">✓</button></div></div>');
      document.getElementById("delCancel").addEventListener("click", closeToolModal);
      document.getElementById("delConfirm").addEventListener("click", async () => {{
        openToolModal(toolLoading());
        try {{
          const r = await fetch("/drop-api/delete", {{ method:"POST", headers:{{"Content-Type":"application/json"}}, body: JSON.stringify({{public_id:pid}}) }});
          const data = await r.json();
          if (data.ok) window.location.href = "/";
          else openToolModal(toolError(data.error));
        }} catch(e) {{ openToolModal(toolError(e.message)); }}
      }});
    }}

    async function execTool(pid, tool) {{
      openToolModal(toolLoading());
      try {{
        const r = await fetch("/drop-api/tool", {{ method:"POST", headers:{{"Content-Type":"application/json"}}, body: JSON.stringify({{tool_id:tool.id, public_id:pid, params:{{}}}}) }});
        const data = await r.json();
        if (!data.ok) {{
          if (data.error === "auth_required") openToolModal('<p class="tool-error">{html_escape(texts.get("signIn", "Sign in"))} → <a href="/auth/login">{html_escape(texts.get("loginLabel", "Login"))}</a></p>');
          else openToolModal(toolError(data.error));
          return;
        }}
        const res = data.result;
        if (res.type === "image") openToolModal('<div class="tool-result-view"><img src="data:' + res.mime + ";base64," + res.data + '" alt="preview"></div>');
        else if (res.type === "list") {{
          let html = '<div class="tool-result-view"><ul class="zip-list">';
          res.items.forEach(f => {{ html += '<li><span>' + f.name + '</span><span class="zip-size">' + f.size + "</span></li>"; }});
          html += '</ul></div>';
          openToolModal(html);
        }} else if (res.type === "text") openToolModal('<div class="tool-result-view"><pre>' + (res.data || "") + "</pre></div>");
        else openToolModal('<pre>' + JSON.stringify(res, null, 2) + "</pre>");
      }} catch(e) {{ openToolModal(toolError(e.message)); }}
    }}
  </script>
  {shared_footer(lang)}
</body>
</html>"""


