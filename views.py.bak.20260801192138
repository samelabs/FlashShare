def shared_header(user, lang: str = "en", texts: dict = None, *, share_url: str = "") -> str:
    """Render the global topbar with brand, auth controls, and language switch."""
    if texts is None:
        texts = server_text(lang)
    locale = LOCALE_TAGS.get(lang, "en")
    direction = "rtl" if lang == "ar" else "ltr"
    
    if user:
        u = public_user(user)
        avatar = (f'<img src="{html_escape(u["avatarUrl"])}" alt="">'
                  if u.get("avatarUrl") else
                  f'<span class="avatar-fallback">{html_escape((u.get("displayName") or u.get("username", "?"))[:1].upper())}</span>')
        display_name = html_escape(u.get("displayName") or u.get("username", ""))
        user_email = html_escape(u.get("email") or "")
        auth_html = f'''<div class="top-actions">
          <div class="user-menu">
            <button class="topbar-profile" id="userMenuBtn" type="button" aria-haspopup="true" aria-expanded="false" aria-label="{html_escape(texts.get("settings", "Settings"))}">{avatar}</button>
            <div class="user-dropdown hidden" id="userDropdown" role="menu">
              <div class="user-info"><span class="user-name">{display_name}</span>{f'<span class="user-email">{user_email}</span>' if user_email else ''}</div>
              <a href="/auth/profile" role="menuitem">{html_escape(texts.get("settings", "Settings"))}</a>
              <form method="post" action="/auth/logout"><button type="submit" class="logout-link">{html_escape(texts.get("logout", "Logout"))}</button></form>
            </div>
          </div>
          {LANG_MENU_HTML}
        </div>'''
    else:
        auth_html = f'''<div class="top-actions">
          <a class="topbar-login" href="/auth/login">{html_escape(texts.get("signIn", "Sign in"))}</a>
          <a class="topbar-register" href="/auth/register">{html_escape(texts.get("signUp", "Register"))}</a>
          {LANG_MENU_HTML}
        </div>'''
    
    share_link = ''
    if share_url:
        share_link = f'''<a class="topbar-share" href="{share_url}" target="_blank" rel="noreferrer" aria-label="{html_escape(texts.get("share", "Share"))}" title="{html_escape(texts.get("share", "Share"))}"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><path d="M8.6 13.5l6.8 4"></path><path d="M15.4 6.5l-6.8 4"></path></svg></a>'''
    
    return f'''<header class="topbar">
      <a class="brand" href="/" aria-label="Flash Share"><span class="brand-mark" aria-hidden="true">{brand_icon_svg()}</span><strong>Flash Share</strong></a>
      {auth_html}
    </header>'''


def shared_footer(lang: str = "en") -> str:
    import datetime
    year = datetime.datetime.now().year
    return f'''<footer class="site-footer">
      <div class="footer-inner">
        <span class="footer-copy">© {year} Flash Share</span>
      </div>
    </footer>
    {LANG_MENU_JS.format(lang=lang)}'''


